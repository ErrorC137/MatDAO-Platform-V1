# =============================================================================
# MatDAO Frontend — v0 / Vercel / any Next.js host
# Copy to .env.local for local dev, or set in your hosting dashboard for production.
# =============================================================================

# --- Production (fill in your deployed service URLs) ---
IP_ENGINE_URL=https://matdao-ip-engine.onrender.com
TRL_SERVICES_URL=https://matdao-trl-services.onrender.com
NEXT_PUBLIC_API_URL=https://matdao-ip-engine.onrender.com
NEXT_PUBLIC_TRL_SERVICES_URL=https://matdao-trl-services.onrender.com

# Optional: public app URL for metadata / CORS on backends
# NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# Supabase Configuration (required for authentication)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Pinata Configuration
PINATA_JWT=your_pinata_jwt_token
PINATA_GATEWAY=your_pinata_gateway

# WalletConnect Configuration (optional, for Web3 wallet connection)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Web3 is testnet-only until the contracts have received an independent
# security audit and the product has completed its legal/compliance review.
NEXT_PUBLIC_MATDAO_CHAIN_ID=11155111
NEXT_PUBLIC_MOCK_USDC_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_MATDAO_IPT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_MATDAO_IPNFT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_MATDAO_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_MATDAO_SWAP_ADDRESS=0x0000000000000000000000000000000000000000

# Google OAuth Configuration (optional, for Google sign-in/sign-up)
# To enable Google OAuth, you need to:
# 1. Go to your Supabase project dashboard → Authentication → Providers → Google
# 2. Enable Google provider (Supabase will provide your redirect URI)
# 3. Copy the redirect URI from Supabase (format: https://[your-project].supabase.co/auth/v1/callback)
# 4. Go to Google Cloud Console → APIs & Services → Credentials
# 5. Create OAuth 2.0 credentials (Web application) or edit existing ones
# 6. Add the Supabase redirect URI to "Authorized redirect URIs"
# 7. Add your frontend domain to "Authorized JavaScript origins"
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

# Hardhat Configuration (for deployment)
PRIVATE_KEY=your_private_key
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_api_key
ETHERSCAN_API_KEY=your_etherscan_api_key
